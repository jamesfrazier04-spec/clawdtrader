# ── Claude AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get from https://dashboard.stripe.com/webhooks  (after adding /webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (SMTP) ────────────────────────────────────────────────────────────────
# Gmail: use App Password (not your real password) from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# The "From" address on outgoing emails (defaults to SMTP_USER if blank)
FROM_EMAIL=

# ── App ─────────────────────────────────────────────────────────────────────────
# Your public URL — must match what you register in Stripe webhook
BASE_URL=https://your-app-domain.com

# Name shown in emails and header
BUSINESS_NAME=AI Content Studio

# Secret key to view /dashboard (change this!)
DASHBOARD_KEY=changeme

# Server port
PORT=8080
